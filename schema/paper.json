{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "records"
  ],
  "properties": {
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "summary"
        ],
        "properties": {
          "type": {
            "enum": [
              "reproduction",
              "artifact_review",
              "correction",
              "author_response",
              "retraction"
            ]
          },
          "paper_version": {
            "type": "string",
            "pattern": "^v[1-9][0-9]*$"
          },
          "result": {
            "enum": [
              "reproduced",
              "partially_reproduced",
              "not_reproduced",
              "inconclusive",
              "verified",
              "resolved",
              "withdrawn"
            ]
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "artifact_missing",
                "artifact_broken",
                "artifact_incomplete",
                "checkpoint_missing",
                "training_code_missing",
                "evaluation_code_missing",
                "raw_results_missing",
                "benchmark_mismatch",
                "metric_mismatch",
                "performance_mismatch",
                "training_mismatch",
                "documentation_incomplete",
                "undocumented_configuration",
                "version_mismatch",
                "independent_reproduction",
                "author_reproduction",
                "corrected",
                "resolved",
                "disputed"
              ]
            }
          },
          "summary": {
            "type": "string",
            "minLength": 20,
            "maxLength": 4000
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^10\\.[0-9]{4,9}/[-._;()/:A-Za-z0-9]+$"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "reproduction",
                    "artifact_review"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "paper_version",
                "tags"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "reproduction"
                }
              }
            },
            "then": {
              "required": [
                "result"
              ]
            }
          }
        ]
      }
    }
  }
}
